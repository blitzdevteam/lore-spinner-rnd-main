From 78834cd79e7866209021cbb31c25e328e2337417 Mon Sep 17 00:00:00 2001
From: Danielnrahimi <77234268+Danielnrahimi@users.noreply.github.com>
Date: Fri, 31 Jul 2026 02:17:06 +0330
Subject: [PATCH 2/4] fix: keep narration playback to a single source swap

Clearing the primed element's source before the download resolved meant two
load() calls on the element iOS Safari ties its playback activation to. The
source is now assigned once, with listeners attached straight after, which also
keeps the silent unlock clip from reporting events against the narration.
---
 resources/js/composables/useTextToSpeech.ts | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/resources/js/composables/useTextToSpeech.ts b/resources/js/composables/useTextToSpeech.ts
index c07ed83..0559605 100644
--- a/resources/js/composables/useTextToSpeech.ts
+++ b/resources/js/composables/useTextToSpeech.ts
@@ -395,16 +395,10 @@ function play(gameId: string, promptId: string) {
     // across a later src-swap + load(), so the deferred play() is permitted.
     const audio = primedAudio ?? new Audio();
     primedAudio = null;
-    // Drop the silent unlock clip before listeners go on, otherwise its
-    // playing/ended events would be reported against this narration.
-    audio.pause();
-    audio.removeAttribute('src');
-    audio.load();
     audio.preload = 'auto';
 
     configureAudioElement(audio);
     applyAudioSettings(audio);
-    attachListeners(audio, key);
     currentAudio = audio;
     activeKey.value = key;
     awaitingSourceKey = key;
@@ -413,8 +407,12 @@ function play(gameId: string, promptId: string) {
         .then((url) => {
             if (activeKey.value !== key) return; // the player moved on while it rendered
 
+            // Exactly one src assignment on this element, and listeners go on
+            // straight after it, so the silent unlock clip it may still be
+            // holding cannot report events against this narration.
             audio.src = url;
             audio.load();
+            attachListeners(audio, key);
             audioCache.set(key, audio);
             awaitingSourceKey = null;
 
