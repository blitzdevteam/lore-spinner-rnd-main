From d184dc7a867ec5c5aa6e3b059641ab0ca482c817 Mon Sep 17 00:00:00 2001
From: Danielnrahimi <77234268+Danielnrahimi@users.noreply.github.com>
Date: Fri, 31 Jul 2026 02:27:27 +0330
Subject: [PATCH 3/4] fix: never let two narrations play at once

Pause and stop only touched currentAudio, and the 'is this the current turn'
check read activeKey, which queuePendingAutoplay moves ahead of the element it
points at. A queued turn could therefore resume the previous turn's element,
and an earlier turn could stay audible with nothing tracking it.

Playback identity now lives in currentKey, every path that starts or pauses
audio silences the other cached elements, and the per-element listeners ignore
events once their turn is no longer current.
---
 resources/js/composables/useTextToSpeech.ts | 80 ++++++++++++++++++---
 1 file changed, 69 insertions(+), 11 deletions(-)

diff --git a/resources/js/composables/useTextToSpeech.ts b/resources/js/composables/useTextToSpeech.ts
index 0559605..19f1c84 100644
--- a/resources/js/composables/useTextToSpeech.ts
+++ b/resources/js/composables/useTextToSpeech.ts
@@ -36,6 +36,11 @@ function collapseMediaPlayer() {
 }
 
 let currentAudio: HTMLAudioElement | null = null;
+
+// The narration `currentAudio` belongs to. Kept separate from activeKey, which
+// is a UI concern that moves ahead of the element while a turn is queued.
+let currentKey: string | null = null;
+
 let rafId: number | null = null;
 let unlockAudio: HTMLAudioElement | null = null;
 let audioUnlocked = false;
@@ -139,12 +144,40 @@ function isAutoplayBlocked(err: unknown): boolean {
     return err instanceof DOMException && err.name === 'NotAllowedError';
 }
 
+/**
+ * Only one narration may ever be audible. Every cached turn keeps its own
+ * element, so a previous turn can still be mid-playback when a new one takes
+ * over — pausing `currentAudio` alone would leave it running.
+ */
+function silenceOthers(keep: HTMLAudioElement | null) {
+    const rewind = (audio: HTMLAudioElement) => {
+        if (!audio.paused) audio.pause();
+        if (audio.currentTime) audio.currentTime = 0;
+    };
+
+    for (const audio of audioCache.values()) {
+        if (audio !== keep) rewind(audio);
+    }
+
+    if (currentAudio && currentAudio !== keep) rewind(currentAudio);
+}
+
 function queuePendingAutoplay(gameId: string, promptId: string) {
     pendingAutoplay = { gameId, promptId };
+
+    // The UI is about to point at this turn, so nothing from an earlier one may
+    // keep playing underneath it. A retry of the current turn keeps its position.
+    const key = `${gameId}:${promptId}`;
+    if (currentKey !== key) {
+        stop();
+        currentAudio = null;
+        currentKey = null;
+    }
+
     // Show a pending-play indicator on the relevant card while we wait for the
     // AudioContext to be unlocked via a user gesture.
     revealMediaPlayer();
-    activeKey.value = `${gameId}:${promptId}`;
+    activeKey.value = key;
     isLoading.value = true;
 }
 
