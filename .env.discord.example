# Local Discord branch. Copy these values into .env.
# This database is a separate local Postgres database. It is not production.

APP_URL=http://localhost:8088
APP_PORT=8088
VITE_PORT=5174

DB_CONNECTION=discord
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=lore_spinner_discord
DB_USERNAME=sail
DB_PASSWORD=secret

DISCORD_DB_HOST=pgsql
DISCORD_DB_PORT=5432
DISCORD_DB_DATABASE=lore_spinner_discord
DISCORD_DB_USERNAME=sail
DISCORD_DB_PASSWORD=secret

FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380
FORWARD_MINIO_PORT=9002
FORWARD_MINIO_CONSOLE_PORT=8901
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026
FORWARD_REVERB_PORT=8081

# Required for the solo test inside Discord:
# DISCORD_APPLICATION_ID and DISCORD_PUBLIC_KEY from the test application.
# Interactions endpoint URL: https://<public-host>/discord/interactions
# Activity URL (voice channel): https://<public-host>/discord/activity
# In the Discord developer portal, map prefix / to the public host with no https://.
# DISCORD_BOT_TOKEN is optional. It is only used by discord:register-test-command.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI="${APP_URL}/discord/callback"
