# Local Discord branch. Copy these values into .env.
# This database is a separate local Postgres database. It is not production.

APP_URL=http://localhost:8088
APP_PORT=8088
VITE_PORT=5174

DB_CONNECTION=discord
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=lore_spinner_discord
DB_USERNAME=sail
DB_PASSWORD=secret

DISCORD_DB_HOST=pgsql
DISCORD_DB_PORT=5432
DISCORD_DB_DATABASE=lore_spinner_discord
DISCORD_DB_USERNAME=sail
DISCORD_DB_PASSWORD=secret

FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380
FORWARD_MINIO_PORT=9002
FORWARD_MINIO_CONSOLE_PORT=8901
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026
FORWARD_REVERB_PORT=8081

# Discord Activity multiplayer (voice channel):
# Players sign in with Discord OAuth and join the platform lobby as guests.
# - DISCORD_CLIENT_SECRET: OAuth2 page of the application. Required.
# - DISCORD_CLIENT_ID: defaults to DISCORD_APPLICATION_ID when empty.
# - DISCORD_BOT_TOKEN: required. It checks the player is really in the activity instance.
# URL Mappings in the developer portal (no https:// in targets):
#   /        -> <public app host>
#   /reverb  -> <public reverb host>   (Reverb websocket, port 8080 behind its own tunnel)
# Interactions endpoint URL: https://<public-host>/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ACTIVITY_ORIGIN=

# Lobby updates are realtime. Run Reverb: vendor/bin/sail up -d reverb
BROADCAST_CONNECTION=reverb
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI="${APP_URL}/discord/callback"
